<?xml version="1.0" encoding="UTF-8"?>
<configs>
    <!--
        Convert existing gas ranges into campfire-compatible workstations.
        V3.x resolves workstation window groups by block name.
        Fuel restrictions and gas burn time are handled by the Harmony DLL.
    -->

    <append xpath="/blocks/block[@name='cntgasRangeWhite']">
        <property name="Class" value="Campfire" />
        <property name="CanPickup" value="true" />
        <property name="TakeDelay" value="8" />
        <property name="DescriptionKey" value="cntgasRangeWhiteDesc" />
        <property name="WorkstationIcon" value="ui_game_symbol_campfire" />
        <property name="CraftIcon" value="ui_game_symbol_spatula" />
        <property name="CraftActionName" value="lblContextActionCook" />
        <property class="Workstation">
            <property name="Modules" value="tools,output,fuel,input" />
            <property name="CraftingAreaRecipes" value="campfire" />
        </property>
        <property name="HeatMapStrength" value="5" />
        <property name="HeatMapTime" value="5000" />
        <property name="HeatMapFrequency" value="1000" />
        <property name="ActiveRadiusEffects" value="buffCampfireAOE,3" />
        <property name="SoundPickup" value="buildingblock_grab" />
        <property name="SoundPlace" value="buildingblock_place" />
    </append>

    <append xpath="/blocks/block[@name='cntgasRangeGrey']">
        <property name="Class" value="Campfire" />
        <property name="CanPickup" value="true" />
        <property name="TakeDelay" value="8" />
        <property name="DescriptionKey" value="cntgasRangeGreyDesc" />
        <property name="WorkstationIcon" value="ui_game_symbol_campfire" />
        <property name="CraftIcon" value="ui_game_symbol_spatula" />
        <property name="CraftActionName" value="lblContextActionCook" />
        <property class="Workstation">
            <property name="Modules" value="tools,output,fuel,input" />
            <property name="CraftingAreaRecipes" value="campfire" />
        </property>
        <property name="HeatMapStrength" value="5" />
        <property name="HeatMapTime" value="5000" />
        <property name="HeatMapFrequency" value="1000" />
        <property name="ActiveRadiusEffects" value="buffCampfireAOE,3" />
        <property name="SoundPickup" value="buildingblock_grab" />
        <property name="SoundPlace" value="buildingblock_place" />
    </append>

    <append xpath="/blocks/block[@name='cntgasRangeBlack']">
        <property name="Class" value="Campfire" />
        <property name="CanPickup" value="true" />
        <property name="TakeDelay" value="8" />
        <property name="DescriptionKey" value="cntgasRangeBlackDesc" />
        <property name="WorkstationIcon" value="ui_game_symbol_campfire" />
        <property name="CraftIcon" value="ui_game_symbol_spatula" />
        <property name="CraftActionName" value="lblContextActionCook" />
        <property class="Workstation">
            <property name="Modules" value="tools,output,fuel,input" />
            <property name="CraftingAreaRecipes" value="campfire" />
        </property>
        <property name="HeatMapStrength" value="5" />
        <property name="HeatMapTime" value="5000" />
        <property name="HeatMapFrequency" value="1000" />
        <property name="ActiveRadiusEffects" value="buffCampfireAOE,3" />
        <property name="SoundPickup" value="buildingblock_grab" />
        <property name="SoundPlace" value="buildingblock_place" />
    </append>

    <!-- Replace the existing CreativeMode values instead of creating duplicates. -->
    <set xpath="/blocks/block[@name='cntgasRangeWhite']/property[@name='CreativeMode']/@value">Player</set>
    <set xpath="/blocks/block[@name='cntgasRangeGrey']/property[@name='CreativeMode']/@value">Player</set>
    <set xpath="/blocks/block[@name='cntgasRangeBlack']/property[@name='CreativeMode']/@value">Player</set>
</configs>
